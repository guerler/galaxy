{
    "about": "GalaxyAI's brain protocol (protocol.ts) as wire transcripts. Each session starts with the handshake on the window: the brain's initialize and the host's answer into the brain's frame, which transfers a MessagePort when it is a result ('port': true). Every later message goes over that port. 'checks' names the sides whose tests replay the session: a side's own messages are expected from it, the other side's are given to it. Errors match by code. A brain's chat/unsavedChanged goes only to a host that declared chat.unsaved.",
    "protocolVersion": "2026-10-19",
    "methods": {
        "initialize": "initialize",
        "initialized": "initialized",
        "chatOpen": "chat/open",
        "chatAsk": "chat/ask",
        "chatActiveChanged": "chat/activeChanged",
        "chatUnsavedChanged": "chat/unsavedChanged"
    },
    "errors": {
        "INVALID_REQUEST": -32600,
        "METHOD_NOT_FOUND": -32601,
        "INVALID_PARAMS": -32602,
        "INTERNAL_ERROR": -32603
    },
    "hostInfo": {
        "name": "galaxy",
        "version": "test"
    },
    "clientInfo": {
        "name": "brain",
        "version": "test"
    },
    "sessions": [
        {
            "name": "opens a saved chat, and the brain reports it shown",
            "checks": [
                "host",
                "brain"
            ],
            "messages": [
                {
                    "from": "brain",
                    "message": {
                        "jsonrpc": "2.0",
                        "id": 1,
                        "method": "initialize",
                        "params": {
                            "protocolVersion": "2026-10-19",
                            "clientInfo": {
                                "name": "brain",
                                "version": "test"
                            },
                            "capabilities": {
                                "chat": {}
                            }
                        }
                    }
                },
                {
                    "from": "host",
                    "port": true,
                    "message": {
                        "jsonrpc": "2.0",
                        "id": 1,
                        "result": {
                            "protocolVersion": "2026-10-19",
                            "hostInfo": {
                                "name": "galaxy",
                                "version": "test"
                            },
                            "capabilities": {
                                "chat": {
                                    "unsaved": {}
                                }
                            }
                        }
                    }
                },
                {
                    "from": "brain",
                    "message": {
                        "jsonrpc": "2.0",
                        "method": "initialized"
                    }
                },
                {
                    "from": "host",
                    "message": {
                        "jsonrpc": "2.0",
                        "id": 1,
                        "method": "chat/open",
                        "params": {
                            "exchange_id": "c1"
                        }
                    }
                },
                {
                    "from": "brain",
                    "message": {
                        "jsonrpc": "2.0",
                        "id": 1,
                        "result": {}
                    }
                },
                {
                    "from": "brain",
                    "message": {
                        "jsonrpc": "2.0",
                        "method": "chat/activeChanged",
                        "params": {
                            "exchange_id": "c1"
                        }
                    }
                }
            ]
        },
